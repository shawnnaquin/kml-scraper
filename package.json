{
  "name": "kml-scraper",
  "version": "2.1.0",
  "description": "Chop big census / Nielsen / Zillow boundary files into one simplified geoJSON file per place.",
  "type": "module",
  "private": true,
  "bin": {
    "kml-scraper": "./bin/kml-scraper.js"
  },
  "engines": {
    "node": ">=22"
  },
  "config": {
    "DISTFOLDER": "dist",
    "DISTTEMPFOLDER": "temp",
    "DISTCOMPLEXFOLDER": "complex",
    "DISTSIMPLEFOLDER": "simplified",
    "DISTRIBUTIONZIPFOLDER": "processed-zip-files",
    "PRECISION": 0.001,
    "GEOPRECISION": 6,
    "SRCFOLDER": "src",
    "SRCCOUNTY": "cb_2025_us_county_500k.zip",
    "SRCSTATE": "cb_2025_us_state_500k.zip",
    "SRCCITY": "cb_2025_us_place_500k.zip",
    "SRCZCTA": "cb_2020_us_zcta520_500k.zip",
    "SRCNEIGHBORHOOD": "overture-neighborhoods.gpkg",
    "OVERTURERELEASE": "latest",
    "SRCDMA": "nielsentopo.json",
    "SRCDMAINFO": "dmainfo.json",
    "SRCCOUNTYDMA": "county-dma-overrides.csv",
    "SRCGOOGLEGEO": "google-geotargets.csv",
    "SRCMSFTGEO": "msft-geolocations.csv",
    "SRCMETAGEO": "meta-geolocations.csv",
    "SRCMETATARGETED": "meta-targeted.csv",
    "SRCTTDGEO": "ttd-geosegments.csv",
    "SRCABBREV": "stateabbrev.json",
    "SRCFIPS": "statefips.json",
    "SRCZILLOWFOLDER": "neighborhoodshp",
    "MAPSAPIKEY": "",
    "PORT": 8080
  },
  "scripts": {
    "kml": "node bin/kml-scraper.js",
    "docker": "docker compose run --rm kml-scraper",
    "docker:build": "docker compose build",
    "docker:shell": "docker compose run --rm --entrypoint bash kml-scraper",
    "test": "node --test",
    "docker:test": "docker compose run --rm --entrypoint node kml-scraper --test",
    "clean": "node bin/kml-scraper.js clean",
    "sizeof": "node bin/kml-scraper.js sizeof",
    "semver": "npm --no-git-tag-version version patch",
    "warning": "node bin/kml-scraper.js warning",
    "beer": "node bin/kml-scraper.js beer",
    "fetch": "node bin/kml-scraper.js fetch",
    "dissolve:dma": "node bin/kml-scraper.js dissolve dma",
    "topo:dma": "node bin/kml-scraper.js topo dma",
    "features:dma": "node bin/kml-scraper.js features dma",
    "shp:neighborhood": "node bin/kml-scraper.js shp neighborhood",
    "shp:county": "node bin/kml-scraper.js shp county",
    "shp:zip": "node bin/kml-scraper.js shp zip",
    "shp:city": "node bin/kml-scraper.js shp city",
    "shp:state": "node bin/kml-scraper.js shp state",
    "process:county": "node bin/kml-scraper.js process county",
    "process:zip": "node bin/kml-scraper.js process zip",
    "process:city": "node bin/kml-scraper.js process city",
    "process:state": "node bin/kml-scraper.js process state",
    "process:neighborhood": "node bin/kml-scraper.js process neighborhood",
    "simplify:county": "node bin/kml-scraper.js simplify county",
    "simplify:zip": "node bin/kml-scraper.js simplify zip",
    "simplify:city": "node bin/kml-scraper.js simplify city",
    "simplify:state": "node bin/kml-scraper.js simplify state",
    "simplify:neighborhood": "node bin/kml-scraper.js simplify neighborhood",
    "simplify:dma": "node bin/kml-scraper.js simplify dma",
    "ids:neighborhood": "node bin/kml-scraper.js ids neighborhood",
    "ids:dma": "node bin/kml-scraper.js ids dma",
    "ids:city": "node bin/kml-scraper.js ids city",
    "ids:zip": "node bin/kml-scraper.js ids zip",
    "ids:county": "node bin/kml-scraper.js ids county",
    "ids:state": "node bin/kml-scraper.js ids state",
    "pack": "node bin/kml-scraper.js pack",
    "neighborhood": "node bin/kml-scraper.js neighborhood",
    "dma": "node bin/kml-scraper.js dma",
    "city": "node bin/kml-scraper.js city",
    "zip": "node bin/kml-scraper.js zip",
    "county": "node bin/kml-scraper.js county",
    "state": "node bin/kml-scraper.js state",
    "zillow": "node bin/kml-scraper.js zillow",
    "all": "node bin/kml-scraper.js all",
    "all:complex": "node bin/kml-scraper.js all:complex",
    "all:simplify": "node bin/kml-scraper.js all:simplify",
    "serve": "node bin/kml-scraper.js serve",
    "docker:serve": "docker compose run --rm --service-ports kml-scraper serve"
  },
  "author": "Shawn Naquin",
  "license": "ISC",
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
